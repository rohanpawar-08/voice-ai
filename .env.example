# =============================================================================
# VoiceDesk AI - Environment Configuration Example
# =============================================================================

# Server Settings
HOST=0.0.0.0
PORT=8000

# Database Settings (PostgreSQL 16 Alpine via Docker Compose)
DATABASE_URL=postgresql+asyncpg://voicedesk:voicedesk_dev_password@localhost:5432/voicedesk

# Redis Settings (Docker Compose default)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Speech-to-Text (STT) & LLM Settings (Groq API)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=whisper-large-v3
LLM_MODEL=openai/gpt-oss-120b

# Neural TTS Settings (Edge TTS)
TTS_VOICE=en-US-ChristopherNeural
TTS_VOICE_EN=en-US-ChristopherNeural
TTS_VOICE_MR=mr-IN-AarohiNeural
TTS_VOICE_MR_MALE=mr-IN-ManoharNeural

# CORS Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","*"]
